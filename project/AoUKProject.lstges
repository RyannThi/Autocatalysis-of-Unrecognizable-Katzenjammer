7,{"$type":".Data.LocalVar, ","Attributes":[{"$type":".DependencyAttrItem, ","attrCap":"Number of Var","attrInput":"1","EditWindow":""},{"attrCap":"Var 1 name","attrInput":"hiscorestring","EditWindow":""},{"attrCap":"Var 1 init value","attrInput":"tostring(scoredata.hiscore['1@Act' .. self.opt_act .. '-' .. self.opt .. '@Sanae_Kochiya'])","EditWindow":"target"}],"AttributeCount":3}
7,{"$type":".Data.Function, ","Attributes":[{"attrCap":"Name","attrInput":"formatnum_n","EditWindow":""},{"attrCap":"Parameter List","attrInput":"num","EditWindow":""},{"attrCap":"Localized","attrInput":"true","EditWindow":"bool"}],"IsExpanded":false,"AttributeCount":3}
8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"local sign = sign(num)\r\nnum = abs(num)\r\nlocal tmp = {}\r\nlocal var\r\nwhile num >= 1000 do\r\n\tvar = num - int(num / 1000) * 1000\r\n\ttable.insert(tmp, 1, string.format(\"%03d\", var))\r\n\tnum = int(num / 1000)\r\nend\r\ntable.insert(tmp, 1, tostring(num))\r\nvar = table.concat(tmp, \",\")\r\nif sign < 0 then\r\n\tvar = string.format(\"-%s\", var)\r\nend\r\nreturn var, #tmp - 1","EditWindow":"code"}],"AttributeCount":1}
