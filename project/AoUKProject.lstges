3,{"$type":".General.CodeSegment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Head","attrInput":"-- MenuInputChecker","EditWindow":"code"},{"attrCap":"Tail","attrInput":"","EditWindow":"code"}],"IsExpanded":false,"AttributeCount":2}
4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"function MenuInputChecker(name)\r\n    while(true) do\r\n        while(not KeyIsPressed(name))do\r\n            coroutine.yield(false) --return false until the key is pressed\r\n        end\r\n        coroutine.yield(true) --return true once\r\n        for i=0, 20 do\r\n            coroutine.yield(false) --return false for 30 frames\r\n            if (not KeyIsDown(name)) then\r\n                break --if the key is not being held down, break out of for (which will make you consequently restart\r\n            end\r\n        end\r\n        while (KeyIsDown(name)) do\r\n            coroutine.yield(true) -- return true once every 3 frames\r\n            for i=0, 2 do\r\n                coroutine.yield(false) --return false for 3 frames\r\n            end\r\n        end\r\n    end\r\nend","EditWindow":"code"}],"AttributeCount":1}
3,{"$type":".General.CodeSegment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Head","attrInput":"-- SetWorldUEX","EditWindow":"code"},{"attrCap":"Tail","attrInput":"","EditWindow":"code"}],"IsExpanded":false,"AttributeCount":2}
4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"function SetWorldUEX(x, y, w, h, bound, m)\r\n\tbound = bound or 32\r\n\tm = m or 15\r\n\tOriginalSetWorld(\r\n\t--l,r,b,t,\r\n\t\t\t(-w / 2), (w / 2), (-h / 2), (h / 2),\r\n\t--bl,br,bb,bt\r\n\t\t\t(-w / 2) - bound, (w / 2) + bound, (-h / 2) - bound, (h / 2) + bound,\r\n\t--sl,sr,sb,st\r\n\t\t\t(x - w/2), (x + w/2), (y - h/2), (y + h/2),\r\n\t--pl,pr,pb,pt\r\n\t\t\t(-w / 2), (w / 2), (-h / 2), (h / 2),\r\n\t--world mask\r\n\t\t\tm\r\n\t)\r\n\tSetBound(lstg.world.boundl, lstg.world.boundr, lstg.world.boundb, lstg.world.boundt)\r\nend","EditWindow":"code"}],"AttributeCount":1}
3,{"$type":".General.CodeSegment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Head","attrInput":"-- Smear UI","EditWindow":"code"},{"attrCap":"Tail","attrInput":"","EditWindow":"code"}],"IsExpanded":false,"AttributeCount":2}
4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"smearui = Class(object)\r\nsmearui.cache = {}\r\nsmearui.func = function(img)\r\n    --修改by OLC，修复了疯狂重复加载的问题\r\n    if lstg.tmpvar.smearuicache == nil then\r\n        lstg.tmpvar.smearuicache = {}\r\n    end\r\n    if not lstg.tmpvar.smearuicache[img] then\r\n        smearui.cache[img] = img .. \"_smear_psi\"\r\n        lstg.tmpvar.smearuicache[img] = img .. \"_smear_psi\"\r\n        LoadPS(img .. \"_smear_psi\", \"THlib\\\\bullet\\\\smear.psi\", img)\r\n    end\r\n    return lstg.tmpvar.smearuicache[img]\r\nend\r\nfunction smearui:init(obj, interval)\r\n    self.master = obj\r\n    self.emission = 60 / (interval or 1)\r\n    self.layer = obj.layer - 1\r\n    self.hscale, self.vscale = 0.6, 0.6\r\n    self.bound = false\r\nend\r\nfunction smearui:frame()\r\n    if self.notframe then\r\n        return\r\n    end\r\n    if not IsValid(self.master) then\r\n        Kill(self)\r\n        return\r\n    end\r\n    self.x = self.master.x\r\n    self.y = self.master.y\r\n    self.rot = self.master.rot\r\n    if self.master.hide or not self.master.img then\r\n        self.hide = true\r\n    else\r\n        self.hide = false\r\n        self.img = smearui.func(self.master.img)\r\n        ParticleSetEmission(self, self.emission)\r\n    end\r\nend\r\nfunction smearui:render()\r\n\tSetViewMode'ui'\r\n\tself.class.base.render(self)\r\n\tSetViewMode'world'\r\nend\r\nfunction smearui:kill()\r\n    self.status = 'normal'\r\n    self.notframe = true\r\n    New(tasker, function()\r\n        local m = ParticleGetEmission(self)\r\n        while true do\r\n            if m < 0 then\r\n                break\r\n            end\r\n            ParticleSetEmission(self, m)\r\n            m = m - 1\r\n            task.Wait(1)\r\n        end\r\n        task.Wait(1)\r\n        Del(self)\r\n    end)\r\nend","EditWindow":"code"}],"AttributeCount":1}
3,{"$type":".General.CodeSegment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Head","attrInput":"-- Format Num Alt","EditWindow":"code"},{"attrCap":"Tail","attrInput":"","EditWindow":"code"}],"IsExpanded":false,"AttributeCount":2}
4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"function formatnumalt(num)\r\n    local sign = sign(num)\r\n    num = abs(num)\r\n    local tmp = {}\r\n    local var\r\n    while num >= 1000 do\r\n        var = num - int(num / 1000) * 1000\r\n        table.insert(tmp, 1, string.format(\"%03d\", var))\r\n        num = int(num / 1000)\r\n    end\r\n    table.insert(tmp, 1, tostring(num))\r\n    var = table.concat(tmp, \",\")\r\n    if sign < 0 then\r\n        var = string.format(\"-%s\", var)\r\n    end\r\n    return var, #tmp - 1\r\nend","EditWindow":"code"}],"AttributeCount":1}
3,{"$type":".General.CodeSegment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Head","attrInput":"-- Format Score","EditWindow":"code"},{"attrCap":"Tail","attrInput":"","EditWindow":"code"}],"IsExpanded":false,"AttributeCount":2}
4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"function FormatScore(num)\r\n    local str = string.format('%012d', num)\r\n    return string.format('%s,%s,%s,%s',\r\n            str:sub(1,3), str:sub(4,6),str:sub(7,9),str:sub(10,12))\r\nend","EditWindow":"code"}],"AttributeCount":1}
3,{"$type":".General.CodeSegment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Head","attrInput":"-- Replay Menu","EditWindow":"code"},{"attrCap":"Tail","attrInput":"","EditWindow":"code"}],"IsExpanded":false,"AttributeCount":2}
4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"menu_replay_loader = New(replay_loader, function(filename, stageName)\r\n\tif not filename then\r\n\t\t--menu.FlyIn(menu_title, 'left')\r\n\t\tmenu.FlyOut(menu_replay_loader, 'right')\r\n\telse\r\n\t\ttask.New(stage_menu, function()\r\n\t\t\tfor i = 1, 60 do\r\n\t\t\t\tSetBGMVolume('menu', 1 - i / 60)\r\n\t\t\t\ttask.Wait()\r\n\t\t\tend\r\n\t\tend)\r\n\t\ttask.New(stage_menu, function()\r\n\t\t\tmenu.FlyOut(menu_replay_loader, 'left')\r\n\t\t\ttask.Wait(30)\r\n\t\t\tNew(mask_fader, 'close')\r\n\t\t\ttask.Wait(30)\r\n\t\t\tPrint(filename, stageName)\r\n\t\t\tstage.IsReplay = true--判定进入rep播放的flag add by OLC\r\n\t\t\tstage.Set('load', filename, stageName)\r\n\t\tend)\r\n\tend\r\nend)","EditWindow":"code"}],"IsBanned":true,"AttributeCount":1}
3,{"$type":".General.CodeSegment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Head","attrInput":"-- Interpolation","EditWindow":"code"},{"attrCap":"Tail","attrInput":"","EditWindow":"code"}],"IsExpanded":false,"AttributeCount":2}
4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"function Interpolate_Decelerate(a, b, x)\r\n    local y = 1 - x\r\n    return (a + (1 - y * y) * (b - a))\r\nend","EditWindow":"code"}],"AttributeCount":1}
3,{"$type":".General.CodeSegment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Head","attrInput":"-- Death Weapon Alt","EditWindow":"code"},{"attrCap":"Tail","attrInput":"","EditWindow":"code"}],"IsExpanded":false,"AttributeCount":2}
4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"death_weapon_alt = Class(object)\r\n\r\nfunction death_weapon_alt:init(x, y)\r\n    self.x = x\r\n    self.y = y\r\n    self.group = GROUP_GHOST\r\n    self.hide = true\r\nend\r\n\r\nfunction death_weapon_alt:frame()\r\n    if self.timer >= 90 then\r\n        Del(self)\r\n    end\r\n    for i, o in ObjList(GROUP_ENEMY) do\r\n        if o.colli == true then\r\n            if Dist(self, o) < 40 and self.timer < 30 then\r\n                Damage(o, 0.4)\r\n                if o.dmgsound == 1 then\r\n                    if o.dmg_factor then\r\n                        if o.hp > 100 then\r\n                            PlaySound('damage00', 0.3, o.x / 200)\r\n                        else\r\n                            PlaySound('damage01', 0.6, o.x / 200)\r\n                        end\r\n                    else\r\n                        if o.hp > o.maxhp * 0.2 then\r\n                            PlaySound('damage00', 0.3, o.x / 200)\r\n                        else\r\n                            PlaySound('damage01', 0.8, o.x / 200)\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n    end\r\n    for i, o in ObjList(GROUP_NONTJT) do\r\n        if o.colli == true then\r\n            if Dist(self, o) < 40 and self.timer < 30 then\r\n                Damage(o, 0.4)\r\n                if o.dmgsound == 1 then\r\n                    if o.dmg_factor then\r\n                        if o.hp > 100 then\r\n                            PlaySound('damage00', 0.3, o.x / 200)\r\n                        else\r\n                            PlaySound('damage01', 0.6, o.x / 200)\r\n                        end\r\n                    else\r\n                        if o.hp > o.maxhp * 0.2 then\r\n                            PlaySound('damage00', 0.3, o.x / 200)\r\n                        else\r\n                            PlaySound('damage01', 0.8, o.x / 200)\r\n                        end\r\n                    end\r\n                end\r\n            end\r\n        end\r\n    end\r\nend","EditWindow":"code"}],"AttributeCount":1}
