4,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"checker_up = coroutine.create(MenuInputChecker)\r\nchecker_down = coroutine.create(MenuInputChecker)\r\nchecker_left = coroutine.create(MenuInputChecker)\r\nchecker_right = coroutine.create(MenuInputChecker)\r\n--local self = {x = 0, y = 0}\r\nif scoredata.tutoriallock == nil then scoredata.tutoriallock = true end\r\nlstg.var.rep_player = \"Sanae\"\r\nlstg.var.isc_item = 1\r\nif scoredata.mp == nil then scoredata.mp = 0 end\r\nfor i = 1, 3 do\r\n\tlocal sc_q = scoredata['quest_' .. i]\r\n\tif sc_q == nil then sc_q = false end\r\nend","EditWindow":"code"}],"AttributeCount":1}
