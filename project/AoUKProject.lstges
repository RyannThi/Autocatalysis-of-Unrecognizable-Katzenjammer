7,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Sanae_16\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"left\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"So, the Youkai Mountain... I didn't really want to come\r\nback yet, but my intuition is really flaring right now...","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(325 - 1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"128","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(325 - 1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
7,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Sanae_7\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"left\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Wait, those two...","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(325 - 1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"128","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(325 - 1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
