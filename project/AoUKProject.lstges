5,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"New(bubble3, \"ani:Sanae_Frog_Ex\", self.x, self.y, self.rot, self.dx, 0, self.omiga, 8, self.hscale + ran:Float(0.5, 1), self.hscale + ran:Float(0.5, 1),\r\n                Color(100, 255, 255, 255), Color(0, 255, 255, 255), self.layer, \"mul+add\")\r\nNew(bubble3, \"ani:Sanae_Frog_Ex\", self.x + ran:Int(-10, 10), self.y + ran:Int(-10, 10), self.rot, self.dx, 0, self.omiga, 8, self.hscale + ran:Float(0.5, 1), self.hscale + ran:Float(0.5, 1),\r\n                Color(100, 255, 255, 255), Color(0, 255, 255, 255), self.layer, \"mul+add\")\r\nNew(bubble3, \"ani:Sanae_Frog_Ex\", self.x + ran:Int(-10, 10), self.y + ran:Int(-10, 10), self.rot, self.dx, 0, self.omiga, 8, self.hscale + ran:Float(0.5, 1), self.hscale + ran:Float(0.5, 1),\r\n                Color(100, 255, 255, 255), Color(0, 255, 255, 255), self.layer, \"mul+add\")\r\nNew(death_weapon_alt, self.x, self.y)\r\nself.class.base.kill(self)","EditWindow":"code"}],"AttributeCount":1}
