7,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Virilia_2\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Oh, there you are. Where's Sibylla? Turns\r\nout that shining thing I saw was a fox, figures.","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"IsExpanded":false,"AttributeCount":13}
7,{"$type":".Task.SetSignal, ","Attributes":[{"attrCap":"Signal Name","attrInput":"tsukasa_run","EditWindow":""},{"attrCap":"Signal Value","attrInput":"false","EditWindow":""}],"AttributeCount":2}
