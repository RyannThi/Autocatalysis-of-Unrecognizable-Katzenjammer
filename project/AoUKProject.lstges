7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.x, self.y = 0 + screen.width, 0\r\nif scoredata.itemsel == nil then scoredata.itemsel = 1 end\r\nself.itemlist = {'img_void', 'image:Trailing_Snake', 'image:Omikuji_Dice', 'image:Frog_Spread', 'image:Tornado_Repelling', 'image:Reawekening_Miracle', 'image:Ocean_Nexus', 'image:Reverse_Amulet'}\r\nself.txt_item = {\"None\" .. \"\\n\" .. \"Trailing Snake\" .. \"\\n\" .. \"Omikuji Dice\" .. \"\\n\" .. \"Frog Spread\" .. \"\\n\" .. \"Tornado Repelling\" .. \"\\n\" .. \"Reawakening Miracle\" .. \"\\n\" .. \"Ocean Nexus\" .. \"\\n\" .. \"Reverse Amulet\"}\r\nself.txt_item2 = {\r\n\t\"None\" .. \"\\n\",\r\n\t\"\\n\" .. \"Trailing Snake\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"Omikuji Dice\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"\\n\" .. \"Frog Spread\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"\\n\" .. \"\\n\" .. \"Tornado Repelling\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"\\n\" .. \"\\n\" .. \"\\n\" .. \"Reawakening Miracle\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"\\n\" .. \"\\n\" .. \"\\n\" .. \"\\n\" .. \"Ocean Nexus\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"\\n\" .. \"\\n\" .. \"\\n\" .. \"\\n\" .. \"\\n\" .. \"Reverse Amulet\" .. \"\\n\"\r\n}\r\nself.txt = {\r\n\r\n\t{\"Scene 1-1\" .. \"\\n\",\r\n\t\"\\n\" .. \"Scene 1-2\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"Scene 1-3\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"\\n\" .. \"Scene 1-4\" .. \"\\n\"},\r\n\t{\"Scene 2-1\" .. \"\\n\",\r\n\t\"\\n\" .. \"Scene 2-2\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"Scene 2-3\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"\\n\" .. \"Scene 2-4\" .. \"\\n\"},\r\n\t{\"Scene 3-1\" .. \"\\n\",\r\n\t\"\\n\" .. \"Scene 3-2\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"Scene 3-3\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"\\n\" .. \"Scene 3-4\" .. \"\\n\"},\r\n\r\n}\r\nself.txt2 = {{\"Scene 1-1\" .. \"\\n\" .. \"Scene 1-2\" .. \"\\n\" .. \"Scene 1-3\" .. \"\\n\" .. \"Scene 1-4\" .. \"\\n\"},\r\n\t\t\t {\"Scene 2-1\" .. \"\\n\" .. \"Scene 2-2\" .. \"\\n\" .. \"Scene 2-3\" .. \"\\n\" .. \"Scene 2-4\" .. \"\\n\"},\r\n\t\t\t {\"Scene 3-1\" .. \"\\n\" .. \"Scene 3-2\" .. \"\\n\" .. \"Scene 3-3\" .. \"\\n\" .. \"Scene 3-4\" .. \"\\n\"}}\r\nself.txt_act = {1, 2, 3}\r\nself.txt_comment = {\r\n\r\n\t{\r\n\t\"What a curious person... Well, she doesn't seem \\n\" ..\r\n\t\"to be part of this incident, but rather just \\n\" ..\r\n\t\"someone else seeking for those things...\",\r\n\t\r\n\t\"Damn, she's really hot! I could barely go through \\n\" ..\r\n\t\"the waves of danmaku she was unleashing! \\n\" ..\r\n\t\"I have to say, she's quite skilled at what she does.\",\r\n\t\r\n\t\"This is a circle of hell! I can't believe she was \\n\" ..\r\n\t\"able to trap me like that... Well, I'm sure I can \\n\" ..\r\n\t\"defeat her next time... Just wait for me...\",\r\n\t\r\n\t\"And thus, I finally defeat her. Isaki... This name \\n\" ..\r\n\t\"sounds kinda familiar... Maybe Reimu has \\n\" ..\r\n\t\"commented about her before.\"\r\n\t},\r\n\t{\r\n\t\"These two, in a way, look or sound kinda familiar \\n\" ..\r\n\t\"too. Wait... Could it be...? \\n\" ..\r\n\t\"Either way, that's a scary laser.\",\r\n\t\r\n\t\"That chest... definitely is fake. It pours such a \\n\" ..\r\n\t\"big amount of money from inside, though, if it was \\n\" ..\r\n\t\"real, that woman would definitely be super rich.\",\r\n\t\r\n\t\"Gah! I'm sick from going in circles so much!\",\r\n\t\r\n\t\"That was so trippy. I'm mesmerized by the amount \\n\" ..\r\n\t\"of colors that were being materialized. Can't say \\n\" ..\r\n\t\"it's not pretty! But so difficult to go around.\"\r\n\t},\r\n\t{\r\n\t\"T\",\r\n\t\r\n\t\"F\",\r\n\t\r\n\t\"G\",\r\n\t\r\n\t\"H\"\r\n\t}\r\n\r\n}\r\nself.txt_spell = {\r\n\r\n\t{\r\n\t'Pathogen Annihilation \"Two Steps in the Afternoon\"',\r\n\t'Greenhouse Effect \"Melting Feathers of a Jackal\"',\r\n\t'Heat Wave \"Fiery Discombobulation\"',\r\n\t'Industrial Necropotence \"Equine Resistance\"',\r\n\t},\r\n\t\r\n\t{\r\n\t'Transient Rain \"Ancient Hologram of Veneralia Veneration\"',\r\n\t'Treasured Phantom Casket \"Connecting the Chain Theory of Roulettes\"',\r\n\t'Novus Iris Nativitas \"Nonconforming Ceremony of Brilliance\"',\r\n\t'Attract Yearn \"White; Reverent Silk Touch of Wish Makers\"',\r\n\t},\r\n\t\r\n\t{\r\n\t'DZXD',\r\n\t'VXZVZ',\r\n\t'BBFDS',\r\n\t'WQEEQW',\r\n\t}\r\n\r\n}\r\nself.opt = scoredata.scene_opt or 1\r\nself.opt_act = scoredata.act_opt or 1\r\nself.alp = 0","EditWindow":"code"}],"IsExpanded":false,"AttributeCount":1}
