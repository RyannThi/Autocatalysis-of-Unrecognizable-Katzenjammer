7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.x, self.y = 0 + screen.width, 0\r\nif scoredata.itemsel == nil then scoredata.itemsel = 1 end\r\nself.itemlist = {'img_void', 'image:Trailing_Snake', 'image:Omikuji_Dice', 'image:Frog_Spread', 'image:Tornado_Repelling', 'image:Reawekening_Miracle', 'image:Ocean_Nexus'}\r\nself.txt = {\r\n\r\n\t{\"Scene 1-1\" .. \"\\n\",\r\n\t\"\\n\" .. \"Scene 1-2\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"Scene 1-3\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"\\n\" .. \"Scene 1-4\" .. \"\\n\"},\r\n\t{\"Scene 2-1\" .. \"\\n\",\r\n\t\"\\n\" .. \"Scene 2-2\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"Scene 2-3\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"\\n\" .. \"Scene 2-4\" .. \"\\n\"},\r\n\r\n}\r\nself.txt2 = {{\"Scene 1-1\" .. \"\\n\" .. \"Scene 1-2\" .. \"\\n\" .. \"Scene 1-3\" .. \"\\n\" .. \"Scene 1-4\" .. \"\\n\"},\r\n\t\t\t {\"Scene 2-1\" .. \"\\n\" .. \"Scene 2-2\" .. \"\\n\" .. \"Scene 2-3\" .. \"\\n\" .. \"Scene 2-4\" .. \"\\n\"}}\r\nself.txt_act = {1, 2}\r\nself.txt_comment = {\r\n\r\n\t{\r\n\t\"sdasdasdasd\",\r\n\t\"zxfzfzxfzxfx\",\r\n\t\"xxxxxxxxxx\",\r\n\t\"xasdasdasd\"\r\n\t},\r\n\t{\r\n\t\"fsfsf\",\r\n\t\"asdasd\",\r\n\t\"zxcz\",\r\n\t\"axxvvvvvvvvvvvv\"\r\n\t}\r\n\r\n}\r\nself.opt = 1\r\nself.opt_act = 1\r\nself.alp = 0","EditWindow":"code"}],"IsExpanded":false,"AttributeCount":1}
