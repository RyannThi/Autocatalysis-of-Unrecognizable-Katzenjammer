5,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"lstg.var.battlefinish = true\r\nstage.group.FinishReplay()\r\nif scoredata.act1_1_cleartimes == nil then\r\n\tscoredata.act1_1_cleartimes = 0\r\nend\r\nscoredata.act1_1_cleartimes = scoredata.act1_1_cleartimes + 1\r\nif lstg.var.playerbullet == false then\r\n\tex.SetSignal(\"playerbul\",true)\r\nend","EditWindow":"code"}],"AttributeCount":1}
