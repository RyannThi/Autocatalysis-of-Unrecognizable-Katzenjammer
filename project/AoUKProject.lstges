3,{"$type":".General.CodeSegment, LuaSTGEditorSharp","Attributes":[{"attrCap":"Head","attrInput":"stage.group.AddStage('Act2-4','1@Act2-4',{lifeleft=8,power=400,faith=50000,bomb=8},true)\r\nstage.group.DefStageFunc('1@Act2-4','init',function(self)\r\n    _init_item(self)\r\n    difficulty=self.group.difficulty\r\n    New(mask_fader,'open')\r\n    if jstg then jstg.CreatePlayers() else New(_G[lstg.var.player_name]) end","EditWindow":"code"},{"attrCap":"Tail","attrInput":"task.New(self,function()\r\n        while coroutine.status(self.task[1])~='dead' do task.Wait() end\r\n        stage.group.FinishReplay()\r\n        New(mask_fader,'close')\r\n        task.New(self,function()\r\n            local _,bgm=EnumRes('bgm')\r\n            for i=1,30 do\r\n                for _,v in pairs(bgm) do\r\n                    if GetMusicState(v)=='playing' then\r\n                        SetBGMVolume(v,1-i/30)\r\n                    end\r\n                end\r\n                task.Wait()\r\n            end\r\n        end)\r\n        task.Wait(30)\r\n        stage.group.FinishStage()\r\n    end)\r\nend)","EditWindow":"code"}],"AttributeCount":2}
