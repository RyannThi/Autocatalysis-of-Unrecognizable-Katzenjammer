8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"if scoredata.act1_1_cleartimes >= 1 and scoredata.act1_2_cleartimes >= 1 and scoredata.act1_3_cleartimes >= 1 and scoredata.act1_4_cleartimes >= 1  then\r\n\tscoredata.act_2_available = true\r\nelse\r\n\tscoredata.act_2_available = false\r\nend\r\n\r\nif scoredata.act2_1_cleartimes >= 1 and scoredata.act2_2_cleartimes >= 1 and scoredata.act2_3_cleartimes >= 1 and scoredata.act2_4_cleartimes >= 1  then\r\n\tscoredata.act_3_available = true\r\nelse\r\n\tscoredata.act_3_available = false\r\nend\r\n\r\nif scoredata.act_2_available == true then\r\n\tif scoredata.act_3_available == true then\r\n\t\tif self.opt_act > 3 then self.opt_act = 1 end\r\n\t\tif self.opt_act < 1 then self.opt_act = 3 end\r\n\telse\r\n\t\tif self.opt_act > 2 then self.opt_act = 1 end\r\n\t\tif self.opt_act < 1 then self.opt_act = 2 end\r\n\tend\r\nelse\r\n\tif self.opt_act > 1 then self.opt_act = 1 end\r\n\tif self.opt_act < 1 then self.opt_act = 1 end\r\nend\r\n\r\nscoredata.scene_opt = self.opt\r\nscoredata.act_opt = self.opt_act","EditWindow":"code"}],"AttributeCount":1}
