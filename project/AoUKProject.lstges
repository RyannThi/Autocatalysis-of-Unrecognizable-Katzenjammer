7,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Sanae_12\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"left\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"I'm so tired... I don't know where to search next...\r\nI think I should just head back to the shrine and...","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(325 - 1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"128","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(325 - 1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
7,{"$type":".Task.SetSignal, ","Attributes":[{"attrCap":"Signal Name","attrInput":"tsukasa2_run","EditWindow":""},{"attrCap":"Signal Value","attrInput":"false","EditWindow":""}],"AttributeCount":2}
