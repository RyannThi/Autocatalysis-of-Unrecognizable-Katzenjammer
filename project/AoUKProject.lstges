6,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"self.x, self.y = 0 + screen.width, 0\r\nself.txt = {\r\n\r\n\t\"10,000,000 Scotch Orchestration\" .. \"\\n\",\r\n\t\"\\n\" .. \"High Altitude Soldier\" .. \"\\n\",\r\n\t\"\\n\" .. \"\\n\" .. \"Natural Speedkiller\" .. \"\\n\",\r\n\r\n}\r\nself.txt_how = {\r\n\r\n\t\"Get at least 10,000,000 score at the end of a scene.\" .. \"\\n\",\r\n\t\"Stay 20 seconds above Y 150.\" .. \"\\n\",\r\n\t\"Clear a scene in under 10 seconds.\" .. \"\\n\",\r\n\r\n}\r\nself.txt_mp = {\r\n\r\n\t\"10\" .. \"\\n\",\r\n\t\"25\" .. \"\\n\",\r\n\t\"15\" .. \"\\n\",\r\n\r\n}\r\nself.txt_comment = {\r\n\r\n\t\"It's a nice first start! Let's see how long you last~!\" .. \"\\n\",\r\n\t\"There is no point of collection in this game, my friend.\" .. \"\\n\",\r\n\t\"Was it luck, or did you get a blessed strategy to end this conundrum?\" .. \"\\n\",\r\n\r\n}\r\nself.txt2 = \"10,000,000 Scotch Orchestration\" .. \"\\n\" .. \"High Altitude Soldier\" .. \"\\n\" .. \"Natural Speedkiller\" .. \"\\n\"\r\nself.opt = 1","EditWindow":"code"}],"IsExpanded":false,"AttributeCount":1}
