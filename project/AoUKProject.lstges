7,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Virilia_4\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Huh, what was that all about?","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"IsExpanded":false,"AttributeCount":13}
7,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Sanae_5\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"left\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Nothing, I'm just too suspicious of her...","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(325 - 1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"128","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(325 - 1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
7,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Virilia_3\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Is that so... What makes you think that way?\r\nShe seemed at least pretty friendly to me.","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"IsExpanded":false,"AttributeCount":13}
7,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Sanae_3\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"left\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"It's just...","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(325 - 1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"128","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(325 - 1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
7,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Virilia_1\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"What a pity. Look, you're too slow, and I'm bored.\r\nHow about a duel until Sibylla shows up?","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"IsExpanded":false,"AttributeCount":13}
