7,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Tsukasa_1\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"I'm nothing but a simple fox, bestie.\r\nAlso- wait, you?","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"2","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"IsExpanded":false,"AttributeCount":13}
7,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Sanae_6\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"left\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Huh? You're still out here? Scram! This incident\r\nis enough, I don't want to deal with you again.","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(325 - 1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"128","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(325 - 1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
