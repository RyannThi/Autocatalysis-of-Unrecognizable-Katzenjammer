10,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"if self.opt_act == 1 then\r\n\tif self.opt == 1 then\r\n\t\tNew(tasker, function()\r\n\t\t\tlast=New(_editor_class[\"Screen_Fader\"],self.x,self.y,{0, 0, 0}, 60, SINE_ACC_DEC, false)\r\n\t\t\ttask._Wait(59)\r\n\t\t\tlstg.var.player_name = 'Sanae_Kochiya'\r\n\t\t\tstage.group.Start(stage.groups['Act1-1'], 0)\r\n\t\tend)\r\n\tend\r\n\tif self.opt == 2 then\r\n\t\tNew(tasker, function()\r\n\t\t\tlast=New(_editor_class[\"Screen_Fader\"],self.x,self.y,{0, 0, 0}, 60, SINE_ACC_DEC, false)\r\n\t\t\ttask._Wait(59)\r\n\t\t\tlstg.var.player_name = 'Sanae_Kochiya'\r\n\t\t\tstage.group.Start(stage.groups['Act1-2'], 0)\r\n\t\tend)\r\n\tend\r\nend\r\ntask.Clear(self,false)","EditWindow":"code"}],"AttributeCount":1}
