6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Yukari_1\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Hello Sanae, it's great to see you here.\r\nYou may be wondering, what exactly is going on?","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Sanae_7\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"left\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Wait, Yukari? Hold on--","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(325 - 1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"128","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(325 - 1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Yukari_2\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Well, to facilitate this exchange, I'd recommend\r\nyou to take a look at the manual after this.","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Sanae_3\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"left\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Huh? What do you mean?","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(325 - 1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"128","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(325 - 1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Yukari_2\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"I know you can't really do that, I don't have any manual here,\r\nbut the one from above knows what I'm talking about.","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Sanae_5\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"left\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Who... are you talking to?\r\nAre you even listening?","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(325 - 1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"128","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(325 - 1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Yukari_5\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"But to simplify things, let me teach you\r\nin practice what this is all about.","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Sanae_14\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"left\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"I... Need to go solve this incident...","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(325 - 1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"128","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(325 - 1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Yukari_5\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"You'll be passing through different places,\r\nchallenging faces you've probably never seen before.","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Yukari_3\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"It may be very difficult, which is why there\r\nis a convenient, new shop at your shrine.","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Yukari_4\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Go there, and you may be able to exchange some Miracle\r\nPoints for handy skills. So, how do you get these MPs?","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Yukari_5\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Well, it's simple. Also in your shrine, there will be a table of\r\nquests or objectives you can complete to gain some of those.","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Yukari_6\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"You also gain a bit more of them every time you clear a scene, so if\r\none of the challenges there are too tough, just fight someone again.","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Yukari_4\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Well, for now that's it. If you have any more\r\nquestions, don't forget to consult the manual.","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
6,{"$type":".Boss.AdvancedSentence, ","Attributes":[{"attrCap":"Image","attrInput":"\"image:Yukari_4\"","EditWindow":"image"},{"attrCap":"Image position","attrInput":"\"right\"","EditWindow":"lrstr"},{"attrCap":"Text","attrInput":"Good luck on your adventure, I know it will certainly be\r\nvery, very interesting. Now how about some warm-up danmaku?","EditWindow":"multilineText"},{"attrCap":"Time","attrInput":"600","EditWindow":""},{"attrCap":"Scale","attrInput":"1,1","EditWindow":"scale"},{"attrCap":"Balloon type (tpic)","attrInput":"1","EditWindow":"bubble_style"},{"attrCap":"Master Char (num)","attrInput":"1","EditWindow":""},{"attrCap":"Image X offset (Px)","attrInput":"(550 - -1 * 150)","EditWindow":""},{"attrCap":"Image Y offset (Py)","attrInput":"116","EditWindow":""},{"attrCap":"Balloon X offset (Tx)","attrInput":"(550 - -1 * 100)","EditWindow":""},{"attrCap":"Balloon Y offset (Ty)","attrInput":"230","EditWindow":""},{"attrCap":"Remain for (x) sentences (tn)","attrInput":"1","EditWindow":""},{"attrCap":"Stay","attrInput":"false","EditWindow":"bool"}],"AttributeCount":13}
