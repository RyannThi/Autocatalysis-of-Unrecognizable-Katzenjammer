7,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"sib_colorsRGB = {{24,234,218},{255, 255, 255},{255,20,63}}\r\nsib_colorID = 1\r\nsib_currentRGB = sib_colorsRGB[sib_colorID]\r\nsib_colorChangeF = -60","EditWindow":"code"}],"AttributeCount":1}
7,{"$type":".Data.Function, ","Attributes":[{"attrCap":"Name","attrInput":"advance_color","EditWindow":""},{"attrCap":"Parameter List","attrInput":"t","EditWindow":""},{"attrCap":"Localized","attrInput":"false","EditWindow":"bool"}],"IsExpanded":false,"AttributeCount":3}
8,{"$type":".General.Code, LuaSTGEditorSharp","Attributes":[{"attrCap":"Code","attrInput":"sib_nextColor = (sib_colorID + 1)\r\nsib_avalue = 0.05\r\nif sib_nextColor > 3 then\r\n\tsib_nextColor = 1\r\nend\r\nfor i = 1, t do\r\n\tsib_avalue = i/t\r\n\tsib_currentRGB =  {Interpolate_Element({sib_colorsRGB[sib_colorID][1], sib_colorsRGB[sib_nextColor][1]}, 1 + sib_avalue), \r\n\t\t\t\t  \t  Interpolate_Element({sib_colorsRGB[sib_colorID][2], sib_colorsRGB[sib_nextColor][2]}, 1 + sib_avalue), \r\n\t\t\t\t  \t  Interpolate_Element({sib_colorsRGB[sib_colorID][3], sib_colorsRGB[sib_nextColor][3]}, 1 + sib_avalue)\r\n\t\t\t\t  \t  }\r\n\ttask.Wait(1)\r\nend\r\nif sib_colorID > 3 then\r\n\tsib_colorID = 1\r\nelse\r\n\tsib_colorID = sib_nextColor\r\nend\r\nreturn","EditWindow":"code"}],"AttributeCount":1}
